\section*{Article 003 — JVD‑Quantized Logic Engine}
\subsection*{1. Spaces and Structures}
\[
\mathbb{R}^9,\qquad B_{M9}=\{b_1,\dots,b_9\}
\]
\[
\mathbb{Z}^9,\qquad \text{bounded by level }L\in\mathbb{N}
\]
A \textbf{Junction Object} is
\[
\Phi=\langle ID_\Phi,\ \mathcal{R},\ C_\Phi,\ G_\Phi\rangle
\]
where \(\mathcal{R}\) are incoming raw vectors, \(C_\Phi\) the context (energy bound, allowed cells, constraints), and \(G_\Phi=g_\Phi\in\mathbb{R}^9\) the goal vector.

\subsection*{2. Encoding and Normalization}
\[
\hat{r}_i = E_{M9}(d_i) \qquad
\tilde{r}_i = \frac{w_i\cdot\hat{r}_i}{\|\hat{r}_i\|+\epsilon}
\]
Collect \(\tilde{\mathcal{R}}=\{\tilde{r}_1,\dots,\tilde{r}_m\}\).

\subsection*{3. Junction–Vector Decomposition (JVD)}
Find an orthogonal basis \(\mathcal{V}=\{v_1,\dots,v_n\}\) such that
\[
v_j\perp v_{j'}\;(j\neq j'),\qquad
\operatorname{span}(\mathcal{V})=\operatorname{span}(\tilde{\mathcal{R}}).
\]

\subsection*{4. Quantization}
\[
Q(v)_k = \operatorname{clip}\!\Bigl(\bigl\lfloor\tfrac{v_k}{\Delta}\bigr\rceil,\ -L,\ L\Bigr)
\]
\[
\bar{v}_j = Q(v_j)\in\mathbb{Z}^9.
\]

\subsection*{5. Scoring Functions}
\begin{align}
S_{\text{coh}}(v_j,g_\Phi) &= \frac{v_j\cdot g_\Phi}{\|v_j\|\|g_\Phi\|} \\[4pt]
d_{\text{grid}}(\bar{v}_j,\mathcal{A}_\Phi) &= \min_{a\in\mathcal{A}_\Phi}\|\bar{v}_j-a\|_1 \\
S_{\text{dist}} &= \sigma(\kappa\cdot d_{\text{grid}}) \\[4pt]
S_{\text{par}} &= f_{\text{par}}(v_j,\bar{v}_j) \\[4pt]
S_{\text{eng}} &=
\begin{cases}
1-\dfrac{E_j}{E_{\max}^{\text{coh}}(t)} & E_j\le E_{\max}^{\text{coh}}(t)\\[6pt]
0 & E_j> E_{\max}^{\text{coh}}(t)
\end{cases}
\end{align}
where \(\sigma\) is a sigmoid, \(\kappa>0\) a scaling constant, and \(f_{\text{par}}\) a domain‑specific parasitic penalty.

\subsection*{6. Composite Fitness}
\[
\Pi_j = \alpha\,S_{\text{coh}} - \beta\,S_{\text{dist}} - \gamma\,S_{\text{par}} + \delta\,S_{\text{eng}}
\]
with \(\alpha,\beta,\gamma,\delta>0\).

\subsection*{7. Royalty–Monopoly Penalty (Article 004)}
\[
\Omega(M)=\frac{1}{(1-M)^2},\qquad
\Pi_j' = \Pi_j - \eta\,\Omega(M),\ \eta>0.
\]

\subsection*{8. Decision Logic (Article 005–006)}
Let \(\theta_{\text{prop}}>\theta_{\text{sup}}\). Then:
\begin{itemize}
  \item \(\Pi_j'\ge\theta_{\text{prop}}\) → **PROPAGATE**.
  \item \(\theta_{\text{sup}}\le\Pi_j'<\theta_{\text{prop}}\) → **TRANSFORM**.
  \item \(\Pi_j'<\theta_{\text{sup}}\) → **SUPPRESS**.
\end{itemize}
These thresholds enforce energy coherence (Article 005), anti‑monopoly (Article 004), and the non‑assimilation of scarcity systems (Article 006).

