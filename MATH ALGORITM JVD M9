\section*{Article 005 — Energy Coherence Enforcement (ECL‑2030)}
\begin{enumerate}
  \item \textbf{Purpose.} Keep all entities within sustainable planetary energy bounds.
  \item \textbf{Energy Bound.} For any entity \(X\):
  \[
  E_X \le E_{\max}^{\text{coh}}(t).
  \]
  \item \textbf{Energy Coherence Score.}
  \[
  S_{\text{eng}}=
  \begin{cases}
  1-\dfrac{E_X}{E_{\max}^{\text{coh}}(t)} & E_X\le E_{\max}^{\text{coh}}(t)\\[6pt]
  0 & E_X> E_{\max}^{\text{coh}}(t)
  \end{cases}
  \]
  \item \textbf{Enforcement.} If \(S_{\text{eng}}=0\) then \(\Pi_j'<\theta_{\text{sup}}\) → **SUPPRESS**.
\end{enumerate}

