"""
scalar-governance-grid

Core scaffolding for representing and evaluating scalar governance states
across institutions, assets, and workflows.
"""

from dataclasses import dataclass
from typing import Dict, Any, List


@dataclass
class ScalarDimension:
    """Single scalar dimension in the governance grid (e.g., compliance, risk, latency)."""
    name: str
    value: float
    min_value: float = 0.0
    max_value: float = 1.0

    def normalized(self) -> float:
        """Return value normalized to [0, 1]."""
        if self.max_value == self.min_value:
            return 0.0
        return (self.value - self.min_value) / (self.max_value - self.min_value)


@dataclass
class GovernanceNode:
    """
    A node in the governance grid: could be a lab, system, workflow, or asset.
    Each node carries a set of scalar dimensions.
    """
    id: str
    label: str
    dimensions: Dict[str, ScalarDimension]

    def score(self, weights: Dict[str, float] | None = None) -> float:
        """
        Compute a weighted scalar score for this node.
        weights: optional mapping from dimension name to weight.
        """
        if not self.dimensions:
            return 0.0

        weights = weights or {k: 1.0 for k in self.dimensions.keys()}
        total_weight = sum(weights.values()) or 1.0

        weighted_sum = 0.0
        for name, dim in self.dimensions.items():
            w = weights.get(name, 0.0)
            weighted_sum += w * dim.normalized()

        return weighted_sum / total_weight


class ScalarGovernanceGrid:
    """
    Container for multiple governance nodes, with methods to
    evaluate, compare, and export scalar governance states.
    """

    def __init__(self) -> None:
        self._nodes: Dict[str, GovernanceNode] = {}

    def add_node(self, node: GovernanceNode) -> None:
        self._nodes[node.id] = node

    def get_node(self, node_id: str) -> GovernanceNode | None:
        return self._nodes.get(node_id)

    def ranked_nodes(self, weights: Dict[str, float] | None = None) -> List[GovernanceNode]:
        """Return nodes ranked by score (highest first)."""
        return sorted(
            self._nodes.values(),
            key=lambda n: n.score(weights),
            reverse=True,
        )

    def snapshot(self, weights: Dict[str, float] | None = None) -> Dict[str, Any]:
        """
        Return a serializable snapshot of the grid:
        node scores, normalized dimensions, and ranking.
        """
        data = []
        for node in self._nodes.values():
            node_data = {
                "id": node.id,
                "label": node.label,
                "score": node.score(weights),
                "dimensions": {
                    name: {
                        "value": dim.value,
                        "normalized": dim.normalized(),
                        "min": dim.min_value,
                        "max": dim.max_value,
                    }
                    for name, dim in node.dimensions.items()
                },
            }
            data.append(node_data)

        ranked = sorted(data, key=lambda d: d["score"], reverse=True)
        return {"nodes": ranked}


def example_grid() -> ScalarGovernanceGrid:
    """
